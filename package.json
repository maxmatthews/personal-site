	},
	"dependencies": {
		"@astrojs/react": "^4.0.0",
		"@astrojs/sitemap": "^3.2.0",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"astro": "^5.0.0",
		"lucide-react": "^0.460.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"sharp": "0.33.5"
	},
	"devDependencies": {
		"@vite-pwa/astro": "^0.5.0",
