---
import { Linkedin, Github } from "lucide-react";

interface Props {
	showPortfolioScroll?: boolean;
}

const { showPortfolioScroll = false } = Astro.props;
---

<header id="header">
	<div class="logo">
		<img
			src="/images/headshot.webp"
			alt="portrait of max matthews"
			width="120"
			height="115"
			loading="eager"
			decoding="async"
		/>
	</div>
	<div class="content">
		<div class="inner">
			<h1>Max Matthews</h1>
			<p>
				Applied AI engineer who ships.
			</p>
			<p>
				Open to senior full-stack and AI engineering roles. Remote, or
				relocating for the right team.
			</p>
		</div>
	</div>
	<nav>
		<ul>
			<li>
				<a
					class="headerLink"
					href="/MatthewsMaxResume.pdf"
					target="_blank"
					rel="noopener noreferrer">Resume</a
				>
			</li>
			<li>
				{
					showPortfolioScroll ? (
						<button class="headerLink" data-scroll-to="portfolio-section-home">
							Portfolio
						</button>
					) : (
						<a class="headerLink" href="/#portfolio-section-home">
							Portfolio
						</a>
					)
				}
			</li>
			<li>
				<a
					class="headerLink"
					href="https://medium.com/mzm"
					target="_blank"
					rel="noopener noreferrer">Blog</a
				>
			</li>
			<li>
				<a
					class="headerLink"
					href="/calendar"
					style="padding-left: 19px; padding-right: 19px;">Calendar</a
				>
			</li>
			<li>
				<a class="headerLink" href="/contact">Contact</a>
			</li>
		</ul>
	</nav>
	<div id="headerSocialIcons">
		<ul class="icons">
			<li>
				<a
					href="https://linkedin.com/in/maxzmatthews"
					target="_blank"
					rel="noopener noreferrer"
					class="icon2"
					aria-label="Max's Linked In Profile"
				>
					<Linkedin size={20} aria-hidden="true" />
					<span class="label">LinkedIn</span>
				</a>
			</li>
			<li>
				<a
					href="https://github.com/maxmatthews/personal-site"
					target="_blank"
					rel="noopener noreferrer"
					class="icon2"
					aria-label="Max's GitHub Profile"
				>
					<Github size={20} aria-hidden="true" />
					<span class="label">GitHub</span>
				</a>
			</li>
		</ul>
	</div>
</header>

<style is:global>
	/* Headshot fills the logo circle */
	#header .logo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	/* Center Lucide SVGs inside circular icon anchors (used in header and
	   contact-form social row). */
	ul.icons li a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		line-height: 1;
	}
	ul.icons li a svg {
		display: block;
	}
</style>

<script>
	// Smooth-scroll within page for buttons with data-scroll-to
	document.querySelectorAll("[data-scroll-to]").forEach((btn) => {
		btn.addEventListener("click", () => {
			const id = btn.getAttribute("data-scroll-to");
			if (!id) return;
			const target = document.getElementById(id);
			target?.scrollIntoView({ behavior: "smooth" });
		});
	});
</script>
