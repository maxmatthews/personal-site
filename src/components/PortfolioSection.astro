---
import { projects } from "../utils/projects";

interface Props {
	id?: string;
}

const { id = "portfolio-section" } = Astro.props;
---

<div id={id} class="body">
	<div id="wrapper">
		<div class="portfolio-page loaded">
			<div class="about-section animate-fade-in-up">
				<h2>About Me</h2>
				<div class="about-content-grid">
					<div class="about-text company-card">
						<p>
							I'm Max Matthews, a senior full-stack JavaScript developer.
							For the past decade I was CTO at tuzag, leading the
							architecture of an agentic AI platform for healthcare and
							B2B/B2C clients. Along the way I've shipped RAG-powered
							chatbots, remote patient monitoring for the VA, and the
							platforms behind them. I bring technical depth across React,
							TypeScript, Node.js, and Postgres alongside leadership
							experience in hiring, mentoring, and setting technical
							strategy. These days, most of that execution runs through
							Claude Code.
						</p>
						<p>
							Syracuse has been home since college. Half my career has
							been remote and I'm open to relocating. My dog Stella has
							been my constant companion through most of it. When I'm not
							at a keyboard I'm usually knee-deep in a DIY project on the
							house, or helping a friend with theirs.
						</p>
						<p>
							I do my best work where the tech and the product are the
							same job. At tuzag that meant CTO calls one hour and
							shipping a feature the next. At Hack Upstate it meant
							running a JavaScript bootcamp and modernizing the curriculum
							with AI tools. Either way the loop is the same: figure out
							what's worth building, ship it, learn from how people
							actually use it.
						</p>
					</div>
					<div class="about-image">
						<img
							src="/images/max-and-stella.webp"
							alt="Max Matthews with Stella"
							class="profile-image"
							loading="lazy"
							decoding="async"
						/>
					</div>
				</div>
			</div>

			<div class="skills-section animate-fade-in-up">
				<h2>What I Build With</h2>
				<div class="skills-grid">
					<div class="skill-category company-card">
						<h3>AI &amp; LLMs</h3>
						<div class="skill-tags">
							<span class="tech-tag">RAG</span>
							<span class="tech-tag">Agentic systems</span>
							<span class="tech-tag">LLM integration</span>
							<span class="tech-tag">Conversational AI</span>
						</div>
					</div>
					<div class="skill-category company-card">
						<h3>Languages &amp; Frontend</h3>
						<div class="skill-tags">
							<span class="tech-tag">TypeScript</span>
							<span class="tech-tag">React</span>
							<span class="tech-tag">Vite</span>
							<span class="tech-tag">TanStack Query</span>
							<span class="tech-tag">TanStack Router</span>
							<span class="tech-tag">Tailwind CSS</span>
							<span class="tech-tag">Radix UI</span>
							<span class="tech-tag">Astro</span>
						</div>
					</div>
					<div class="skill-category company-card">
						<h3>Backend &amp; Data</h3>
						<div class="skill-tags">
							<span class="tech-tag">Node.js</span>
							<span class="tech-tag">Supabase</span>
							<span class="tech-tag">Postgres</span>
							<span class="tech-tag">MongoDB</span>
							<span class="tech-tag">Express</span>
							<span class="tech-tag">REST APIs</span>
						</div>
					</div>
					<div class="skill-category company-card">
						<h3>Realtime &amp; Rich UX</h3>
						<div class="skill-tags">
							<span class="tech-tag">Yjs</span>
							<span class="tech-tag">Hocuspocus</span>
							<span class="tech-tag">TipTap</span>
							<span class="tech-tag">React Flow</span>
							<span class="tech-tag">CodeMirror</span>
						</div>
					</div>
				</div>
			</div>

			<div class="workflow-section animate-fade-in-up">
				<h2>How I Work</h2>
				<div class="workflow-card company-card">
					<p>
						My code ships through a team of agentic AI engineers I lead.
						I set the direction, design the architecture, judge the
						trade-offs, and review every change. Agents run in parallel
						— exploring the codebase, implementing, testing, and bringing
						the work back for sign-off.
					</p>
					<p>
						The leverage compounds. I take on bigger scope, learn new
						stacks faster, and ship things I wouldn't have attempted
						alone. The most recent rebuild of tuzag's platform, a modern
						React 19, self hosted Supabase, and realtime-collaboration
						stack, was built this way.
					</p>
				</div>
			</div>

			<div class="employment-section animate-fade-in-up">
				<h2>Employment History</h2>
				<div class="employment-grid">
					<a href="/portfolio/vailent" class="company-card">
						<div class="company-header">
							<h3>Vailent</h3>
							<span class="company-period">
								November 2025 - May 2026
							</span>
						</div>
						<div class="company-description">
							<p>AI Product Data Platform for Industrial Distribution</p>
							<p>
								Full Stack Engineer on Catalog, Vailent's AI-powered
								product data and document tool for industrial
								distribution.
							</p>
						</div>
						<div class="company-projects">
							<span class="project-count">Full Stack</span>
							<span class="project-count">AI / LLMs</span>
							<span class="project-count">Product Engineering</span>
						</div>
						<button class="learn-more-button" type="button">Learn More</button>
					</a>

					<a href="/portfolio/tuzag" class="company-card">
						<div class="company-header">
							<h3>tuzag</h3>
							<span class="company-period">
								July 2015 - October 2025
							</span>
						</div>
						<div class="company-description">
							<p>Conversational AI Startup</p>
							<p>
								Entrepreneurial senior full-stack JavaScript developer and
								technical leader with 10+ years of experience building,
								scaling, and shipping applications across startups,
								enterprise, and government.
							</p>
						</div>
						<div class="company-projects">
							<span class="project-count">AI Integration</span>
							<span class="project-count">Daily Development</span>
							<span class="project-count">Team Leadership</span>
						</div>
						<button class="learn-more-button" type="button">Learn More</button>
					</a>

					<a href="/portfolio/hack-upstate" class="company-card">
						<div class="company-header">
							<h3>Hack Upstate</h3>
							<span class="company-period">
								April 2019 - October 2024
							</span>
						</div>
						<div class="company-description">
							<p>Careers in Code Bootcamp</p>
							<p>
								Led software education program operations, modernized
								curriculum with AI tools, and built student pipelines into
								tech careers.
							</p>
						</div>
						<div class="company-projects">
							<span class="project-count">Curriculum Development</span>
							<span class="project-count">Student Mentoring</span>
						</div>
						<button class="learn-more-button" type="button">Learn More</button>
					</a>
				</div>
			</div>

			<div class="projects-section animate-fade-in-up">
				<h2>Featured Projects</h2>
				<div class="portfolio-grid">
					{projects.map((project, index) => (
						<a
							href={`/portfolio/${project.slug}`}
							class="project-card animate-fade-in-up"
							style={`animation-delay: ${0.2 + index * 0.1}s;`}
						>
							<div class="project-image">
								{project.image ? (
									<img
										src={project.image}
										alt={project.imageAlt}
										class="project-screenshot"
										loading="lazy"
										decoding="async"
									/>
								) : (
									<div class="placeholder-image">
										<span>{project.title.charAt(0)}</span>
									</div>
								)}
							</div>
							<div class="project-content">
								<h3>{project.title}</h3>
								<p>{project.description}</p>
								<div class="project-technologies">
									{project.technologies.map((tech) => (
										<span class="tech-tag">{tech}</span>
									))}
								</div>
								<button class="learn-more-button" type="button">Learn More</button>
							</div>
						</a>
					))}
				</div>
			</div>
		</div>
	</div>
</div>

