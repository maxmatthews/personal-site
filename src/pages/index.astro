---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PortfolioSection from "../components/PortfolioSection.astro";
import RecentPosts from "../components/RecentPosts.jsx";
import { ChevronDown } from "lucide-react";
---

<Layout wrap={false}>
	<div class="body">
		<div id="wrapper">
			<Header showPortfolioScroll={true} />
			<Footer />
		</div>

		<div
			class="arrow-down-container"
			data-arrow-container
			style="position: fixed; left: 50%; transform: translateX(-50%); bottom: 60px; z-index: 60;"
		>
			<button
				class="arrow-down"
				type="button"
				aria-label="Scroll to portfolio"
				data-scroll-target="portfolio-section-home"
				style="background: transparent; border: none; cursor: pointer; color: white;"
			>
				<ChevronDown size={36} aria-hidden="true" />
			</button>
		</div>

		<div id="portfolio-section-home">
			<PortfolioSection />
		</div>

		<RecentPosts client:visible />
	</div>
</Layout>

<script>
	// Scroll-down arrow: visible only at top of page on larger screens
	const arrowContainer = document.querySelector<HTMLElement>(
		"[data-arrow-container]",
	);
	if (arrowContainer) {
		const update = () => {
			const visible = window.innerWidth >= 576 && window.scrollY < 1;
			arrowContainer.style.visibility = visible ? "visible" : "hidden";
		};
		update();
		window.addEventListener("scroll", update, { passive: true });
		window.addEventListener("resize", update);
	}

	// Smooth-scroll to any element with id matching data-scroll-target
	document.querySelectorAll<HTMLElement>("[data-scroll-target]").forEach((btn) => {
		btn.addEventListener("click", () => {
			const id = btn.getAttribute("data-scroll-target");
			if (!id) return;
			document.getElementById(id)?.scrollIntoView({ behavior: "smooth" });
		});
	});
</script>
