---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../utils/projects";

const companyProjects = projects.filter(
	(project) => project.company === "vailent",
);
---

<Layout
	title="Vailent - Max Matthews"
	description="Full Stack Engineer at Vailent, building Catalog: an AI-powered product data and document tool for industrial distribution."
	wrap={false}
>
	<div class="body">
		<div id="wrapper">
			<button
				class="back-button-fixed"
				type="button"
				onclick="history.back()"
				aria-label="Go back"
			>
				<svg
					width="24"
					height="24"
					viewBox="0 0 24 24"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path
						d="M19 12H5M12 19L5 12L12 5"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</button>
			<div class="company-page loaded">
				<div class="company-header animate-fade-in-up">
					<h1>Vailent</h1>
					<p class="company-subtitle">
						Full Stack Engineer • November 2025 - May 2026
					</p>
					<div class="company-description">
						<p>
							Vailent builds Catalog, an AI-powered product data and
							document tool for industrial distribution. As described on
							their <a
								href="https://www.vailent.com/solutions/material-management"
								target="_blank"
								rel="noopener noreferrer">public product page</a
							>, Catalog consolidates supplier documents, specifications,
							pricing, and inventory data into a governed source of truth
							for account managers, product directors, and technical
							directors.
						</p>
						<p>
							I joined as a Full Stack Engineer, contributing features
							across the product alongside a small team.
						</p>
					</div>
				</div>

				<div class="company-projects-section animate-fade-in-up">
					<h2>Project</h2>
					<div class="company-projects-grid">
						{companyProjects.map((project, index) => (
							<a
								href={`/portfolio/${project.slug}`}
								class="company-project-card animate-fade-in-up"
								style={`animation-delay: ${0.2 + index * 0.1}s;`}
							>
								<div class="project-image">
									{project.image ? (
										<img
											src={project.image}
											alt={project.imageAlt}
											class="project-screenshot"
											loading="lazy"
											decoding="async"
										/>
									) : (
										<div class="placeholder-image">
											<span>{project.title.charAt(0)}</span>
										</div>
									)}
								</div>
								<div class="project-content">
									<h3>{project.title}</h3>
									<p>{project.description}</p>
									<div class="project-technologies">
										{project.technologies.map((tech) => (
											<span class="tech-tag">{tech}</span>
										))}
									</div>
								</div>
							</a>
						))}
					</div>
				</div>
			</div>
		</div>
	</div>
</Layout>
