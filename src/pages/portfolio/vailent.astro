---
import Layout from "../../layouts/Layout.astro";
---

<Layout
	title="Vailent - Max Matthews"
	description="Full Stack Engineer at Vailent, November 2025 - May 2026."
	wrap={false}
>
	<div class="body">
		<div id="wrapper">
			<button
				class="back-button-fixed"
				type="button"
				onclick="history.back()"
				aria-label="Go back"
			>
				<svg
					width="24"
					height="24"
					viewBox="0 0 24 24"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path
						d="M19 12H5M12 19L5 12L12 5"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</button>
			<div class="company-page loaded">
				<div class="company-header animate-fade-in-up">
					<h1>Vailent</h1>
					<p class="company-subtitle">
						Full Stack Engineer • November 2025 - May 2026
					</p>
					<div class="company-description">
						<p>
							Full-Stack Engineer working on internal platform tooling.
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</Layout>
