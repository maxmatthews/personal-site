---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../utils/projects";

const companyProjects = projects.filter(
	(project) => project.company === "vailent",
);
---

<Layout
	title="Vailent - Max Matthews"
	description="Full Stack Engineer at Vailent, building Catalog: an AI-powered product data platform for industrial distribution."
	wrap={false}
>
	<div class="body">
		<div id="wrapper">
			<button
				class="back-button-fixed"
				type="button"
				onclick="history.back()"
				aria-label="Go back"
			>
				<svg
					width="24"
					height="24"
					viewBox="0 0 24 24"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path
						d="M19 12H5M12 19L5 12L12 5"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</button>
			<div class="company-page loaded">
				<div class="company-header animate-fade-in-up">
					<h1>Vailent</h1>
					<p class="company-subtitle">
						Full Stack Engineer • November 2025 - May 2026
					</p>
					<div class="company-description">
						<p>
							Vailent builds Catalog, an AI-powered product data platform
							for chemical materials companies. It consolidates supplier
							documents, specifications, pricing, and inventory into a
							governed source of truth for account managers, product
							directors, and technical directors across industrial
							distribution.
						</p>
						<p>
							I joined as a Full Stack Engineer to ship core features of
							Catalog and to partner with an AI engineer on a Neo4j
							knowledge graph that powers material equivalence lookups,
							application-based product matching, and semantic discovery
							across the catalog.
						</p>
					</div>
				</div>

				<div class="company-projects-section animate-fade-in-up">
					<h2>Key Projects at Vailent</h2>
					<div class="company-projects-grid">
						{companyProjects.map((project, index) => (
							<a
								href={`/portfolio/${project.slug}`}
								class="company-project-card animate-fade-in-up"
								style={`animation-delay: ${0.2 + index * 0.1}s;`}
							>
								<div class="project-image">
									{project.image ? (
										<img
											src={project.image}
											alt={project.imageAlt}
											class="project-screenshot"
											loading="lazy"
											decoding="async"
										/>
									) : (
										<div class="placeholder-image">
											<span>{project.title.charAt(0)}</span>
										</div>
									)}
								</div>
								<div class="project-content">
									<h3>{project.title}</h3>
									<p>{project.description}</p>
									<div class="project-technologies">
										{project.technologies.map((tech) => (
											<span class="tech-tag">{tech}</span>
										))}
									</div>
								</div>
							</a>
						))}
					</div>
				</div>

				<div class="company-achievements animate-fade-in-up">
					<h2>Key Achievements</h2>
					<div class="achievements-grid">
						<div class="achievement-item">
							<h3>Catalog Feature Delivery</h3>
							<p>
								Built core features for Catalog, Vailent's AI-powered
								product data platform for chemical materials companies.
							</p>
						</div>
						<div class="achievement-item">
							<h3>Neo4j Knowledge Graph</h3>
							<p>
								Partnered with an AI engineer to design and build a Neo4j
								knowledge graph powering material equivalence lookups,
								application-based product matching, and semantic discovery
								across the catalog.
							</p>
						</div>
						<div class="achievement-item">
							<h3>AI Development Lifecycle</h3>
							<p>
								Leveraged Claude Code at every stage of the SDLC,
								transforming traditional workflows into an AI Development
								Lifecycle (AIDLC) spanning PM requirements intake,
								architecture, implementation, code review, and DevOps.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</Layout>
