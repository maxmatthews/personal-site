---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../utils/projects";

const project = projects.find((p) => p.slug === "vailent-catalog")!;
---

<Layout
	title="Vailent Catalog - Max Matthews"
	description="Vailent's AI-powered product data and document tool for industrial distribution."
	wrap={false}
>
	<div class="body">
		<div id="wrapper">
			<button
				class="back-button-fixed"
				type="button"
				onclick="history.back()"
				aria-label="Go back"
			>
				<svg
					width="24"
					height="24"
					viewBox="0 0 24 24"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path
						d="M19 12H5M12 19L5 12L12 5"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</button>
			<div class="project-details-page loaded">
				<div class="project-header animate-fade-in-up">
					<h1>{project.title}</h1>
					<p class="project-subtitle">{project.description}</p>
				</div>

				<div class="project-content-grid">
					<div class="project-hero-section animate-fade-in-up">
						<div class="project-image-large">
							<div class="placeholder-image">
								<span>{project.title.charAt(0)}</span>
							</div>
						</div>
					</div>

					<div class="project-main-content">
						<div class="project-about-section animate-fade-in-up">
							<h3>About Catalog</h3>
							<div class="project-description">
								<p>
									The following description is drawn from Vailent's
									public <a
										href="https://www.vailent.com/solutions/material-management"
										target="_blank"
										rel="noopener noreferrer">product page</a
									>.
								</p>
								<p>
									Catalog is a centralized product data and document
									management layer for industrial distribution. It
									consolidates supplier documents, specifications, pricing,
									and inventory into a governed source of truth, replacing
									fragmented systems with synchronized, version-controlled
									product information for account managers, product
									directors, and technical directors.
								</p>
								<p>
									Vailent describes the platform as turning scattered
									product documentation into an intelligent, searchable
									knowledge base, with AI-driven extraction of technical
									data sheets and safety documents, natural-language
									querying across the material database, and side-by-side
									material comparisons.
								</p>
							</div>
						</div>

						<div class="project-about-section animate-fade-in-up">
							<h3>My Role</h3>
							<div class="project-description">
								<p>
									I joined Vailent as a Full Stack Engineer in November
									2025 and contributed features across the product
									alongside a small team through May 2026.
								</p>
							</div>
						</div>

						<div class="project-details-grid">
							<div class="project-section animate-fade-in-left">
								<h3>Technologies</h3>
								<div class="technologies-list">
									{project.technologies.map((tech) => (
										<span class="tech-tag-large">{tech}</span>
									))}
								</div>
							</div>
						</div>

						<div class="project-links-section animate-fade-in-up">
							<div class="project-links">
								<a
									href="https://www.vailent.com/solutions/material-management"
									target="_blank"
									rel="noopener noreferrer"
									class="project-link primary"
								>
									<svg
										width="20"
										height="20"
										viewBox="0 0 24 24"
										fill="none"
										xmlns="http://www.w3.org/2000/svg"
									>
										<path
											d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"></path>
									</svg>
									Vailent's Product Page
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</Layout>
